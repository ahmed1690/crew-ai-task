# ==== LLM: NVIDIA API (OpenAI-compatible) ====
NVIDIA_API_KEY=<put ur api token here>
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.2

# ==== Atlassian MCP (Jira) ====
ATLASSIAN_MCP_URL=https://mcp.atlassian.com/v1/sse
ATLASSIAN_SITE_URL=https://your-domain.atlassian.net
JIRA_PROJECT_KEY=VER

# ==== Appium MCP ====
APPIUM_MCP_COMMAND=node
APPIUM_MCP_ARGS=C:\Users\ahmed\AppData\Roaming\npm\node_modules\appium-mcp\dist\index.js
ANDROID_HOME=C:\Users\ahmed\AppData\Local\Android\Sdk

APPIUM_SERVER_URL=http://127.0.0.1:4723
ANDROID_DEVICE_NAME=127.0.0.1:5555
ANDROID_APP_PACKAGE=com.vericash.product_consumer_internal
ANDROID_APP_ACTIVITY=com.vericash.Sanlam.MainActivity

# ==== Filesystem MCP ====
FILESYSTEM_MCP_COMMAND=npx
FILESYSTEM_MCP_ARGS=-y,@modelcontextprotocol/server-filesystem,D:\vericash_crew\vericash_crew\reports

REPORTS_DIR=D:\vericash_crew\vericash_crew\reports