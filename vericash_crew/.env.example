# ==== LLM (CrewAI agents need a model) ====
OPENAI_API_KEY=sk-xxxx
# أو لو بتستخدم Anthropic/Claude بدل OpenAI:
# ANTHROPIC_API_KEY=sk-ant-xxxx

# ==== Atlassian MCP (Jira) ====
# رابط التوثيق الرسمي: https://www.atlassian.com/platform/remote-mcp-server
ATLASSIAN_MCP_URL=https://mcp.atlassian.com/v1/sse
ATLASSIAN_SITE_URL=https://your-domain.atlassian.net
JIRA_PROJECT_KEY=VER

# ==== Appium MCP ====
# لو بتستخدم appium-mcp-server (npm) أو أي implementation تاني
APPIUM_MCP_COMMAND=npx
APPIUM_MCP_ARGS=-y,@appium/mcp-server
APPIUM_SERVER_URL=http://127.0.0.1:4723
ANDROID_DEVICE_NAME=emulator-5554
ANDROID_APP_PACKAGE=com.vericash.app
ANDROID_APP_ACTIVITY=.MainActivity

# ==== Filesystem MCP ====
# الـ official server من modelcontextprotocol/servers
FILESYSTEM_MCP_COMMAND=npx
FILESYSTEM_MCP_ARGS=-y,@modelcontextprotocol/server-filesystem,/home/claude/vericash_crew/reports

REPORTS_DIR=/home/claude/vericash_crew/reports
